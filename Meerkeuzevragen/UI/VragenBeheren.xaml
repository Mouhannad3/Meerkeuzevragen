<Window x:Class="UI.VragenBeheren"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UI"
        mc:Ignorable="d"
        Title="Vragen beheren" Height="700" Width="900">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

      
        <StackPanel Grid.Column="0">

            <TextBlock Text="Nieuwe vraag toevoegen"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,15"/>

            <TextBlock Text="Onderwerp"/>
            <ComboBox x:Name="ComboBoxOnderwerpToevoegen"
                      Height="30"
                      Margin="0,5,0,10"/>

            <TextBlock Text="Vraag"/>
            <TextBox x:Name="TextBoxVraag"
                     Height="70"
                     Margin="0,5,0,10"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"/>

            <TextBlock Text="Antwoord A"/>
            <TextBox x:Name="TextBoxAntwoordA"
                     Height="25"
                     Margin="0,5,0,10"/>

            <TextBlock Text="Antwoord B"/>
            <TextBox x:Name="TextBoxAntwoordB"
                     Height="25"
                     Margin="0,5,0,10"/>

            <TextBlock Text="Antwoord C"/>
            <TextBox x:Name="TextBoxAntwoordC"
                     Height="25"
                     Margin="0,5,0,10"/>

            <TextBlock Text="Antwoord D"/>
            <TextBox x:Name="TextBoxAntwoordD"
                     Height="25"
                     Margin="0,5,0,10"/>

            <TextBlock Text="Antwoord E optioneel"/>
            <TextBox x:Name="TextBoxAntwoordE"
                     Height="25"
                     Margin="0,5,0,10"/>

            <TextBlock Text="Correct antwoord"/>
            <ComboBox x:Name="ComboBoxCorrectAntwoord"
                      Height="30"
                      Margin="0,5,0,15">
                <ComboBoxItem Content="A"/>
                <ComboBoxItem Content="B"/>
                <ComboBoxItem Content="C"/>
                <ComboBoxItem Content="D"/>
                <ComboBoxItem Content="E"/>
            </ComboBox>

            <Button Content="Vraag toevoegen"
                    Height="35"
                    Click="ButtonVraagToevoegen_Click"/>

        </StackPanel>

       
        <StackPanel Grid.Column="2">

            <TextBlock Text="Vraag niet beschikbaar stellen"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,15"/>

            <TextBlock Text="Onderwerp"/>
            <ComboBox x:Name="ComboBoxOnderwerpBeheren"
                      Height="30"
                      Margin="0,5,0,10"/>

            <Button Content="Vragen laden"
                    Height="30"
                    Margin="0,0,0,10"
                    Click="ButtonVragenLaden_Click"/>

            <TextBlock Text="Beschikbare vragen"/>
            <ListBox x:Name="ListBoxVragen"
                     Height="360"
                     Margin="0,5,0,15"/>

            <Button Content="Niet beschikbaar stellen"
                    Margin="0,20,0,0"
                    Height="35"
                    Click="ButtonNietBeschikbaar_Click"/>

        </StackPanel>

    </Grid>
</Window>