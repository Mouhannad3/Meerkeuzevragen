<Window x:Class="UI.BulkResultatenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bulk resultaten verwerken" Height="420" Width="650"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Bulk resultaten verwerken"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0"
                   Content="Bestand:"
                   Width="80"/>

            <TextBox Grid.Column="1"
                     Name="TextBoxPad"
                     Height="25"
                     IsReadOnly="True"/>

            <Button Grid.Column="2"
                    Content="Bladeren"
                    Width="90"
                    Margin="10,0,0,0"
                    Click="ButtonBladeren_Click"/>
        </Grid>

        <DataGrid Grid.Row="2"
                  Name="DataGridResultaten"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Test" Binding="{Binding Test.Naam}" Width="*"/>
                <DataGridTextColumn Header="Gebruiker" Binding="{Binding Gebruiker.Naam}" Width="*"/>
                <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="80"/>
                <DataGridTextColumn Header="Totaal" Binding="{Binding TotaalAantalVragen}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button Content="Sluiten"
                    Width="90"
                    Margin="5"
                    Click="ButtonSluiten_Click"/>

            <Button Content="Verwerken"
                    Width="100"
                    Margin="5"
                    IsDefault="True"
                    Click="ButtonVerwerken_Click"/>
        </StackPanel>
    </Grid>
</Window>